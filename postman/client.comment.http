@host = http://localhost:5000

###Create Comment
POST {{host}}/v1/api/comments HTTP/1.1
content-type: application/json

{
  "comment": 
    {
    "post_id" : "7bd3cafa-9d93-44dd-8b24-fd623abce12b",
    "user_id" :"526c0b00-677d-11ee-8390-0242ac150004",
    //"reply_to_id" : 1,
    "content" :"Hi"
    }
}

###Create Comment Has Parent
POST {{host}}/v1/api/comments HTTP/1.1
content-type: application/json

{
  "comment": 
    {
    "post_id" : "7bd3cafa-9d93-44dd-8b24-fd623abce12b",
    "user_id" :"526c0b00-677d-11ee-8390-0242ac150004",
    //"reply_to_id" : 1,
    "content" :"Hi a",
    "parent_comment_id" : "7e12749e-25e2-4c64-87b5-a3e903418fda"
    }
}

###Update Comment
PUT {{host}}/v1/api/comments/3de6407d-d10b-4cf7-a4ae-267253a47335 HTTP/1.1
content-type: application/json

{
  "comment": 
    {
      "content" :"Reply comment"
    }
  
}

