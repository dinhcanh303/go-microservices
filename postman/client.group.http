@host = http://localhost:5000

###Create Group
POST {{host}}/v1/api/groups HTTP/1.1
content-type: application/json

{
  "group": 
    {
    "name" : "TEAM DEV",
    "description" :"who is that",
    "status" : 1,
    "user_id" :"526c0b00-677d-11ee-8390-0242ac150004"
    }
  
}

###Update Group
PUT {{host}}/v1/api/groups/3a1feefe-f300-4bf3-ba6c-c7acf9a701f0 HTTP/1.1
content-type: application/json

{
  "group": 
    {
    "id":"3a1feefe-f300-4bf3-ba6c-c7acf9a701f0",
    "name" : "TEAM DEV 3",
    "description" :"who is that",
    "status" : 1
    }
  
}

###Get Group
GET {{host}}/v1/api/groups/07e314e7-bee1-411f-bb94-820c74f124b2 HTTP/1.1
content-type: application/json

{}

###Delete Group
DELETE  {{host}}/v1/api/groups/07e314e7-bee1-411f-bb94-820c74f124b2 HTTP/1.1
content-type: application/json

